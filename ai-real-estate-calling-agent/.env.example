# =============================================================================
# AI REAL ESTATE COLD CALLING AGENT - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to Git.  Keep all secrets out of version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-secret
# Public base URL for webhooks/tunnel (your cloudflared URL - ngrok is NOT used).
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_calling
# Redis - only introduced in later phases if actually required
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# TELEPHONY (Plivo - used as telephony + audio transport, NOT Plivo AI agent)
# -----------------------------------------------------------------------------
TELEPHONY_PROVIDER=plivo        # plivo | mock
# Fill real values here when you are ready to place real calls.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Plivo API base + nominal India outbound per-minute rate (cost tracking only).
PLIVO_ENDPOINT=https://api.plivo.com/v1/Account
PLIVO_COST_PER_MINUTE=0.38

# -----------------------------------------------------------------------------
# SPEECH-TO-TEXT (Sarvam)
# -----------------------------------------------------------------------------
STT_PROVIDER=sarvam             # sarvam | mock
SARVAM_API_KEY=
# Sarvam STT cost (configurable for cost tracking)
STT_COST_PER_MINUTE=1.5
# Sarvam STT request tuning
STT_MODEL=saaras:v3             # saaras:v3 (default) | saaras:v4
STT_MODE=codemix                # codemix (Hinglish) | transcribe | translit | translate | verbatim
STT_LANGUAGE_CODE=hi-IN         # BCP-47 code of the call language
STT_ENDPOINT=https://api.sarvam.ai/speech-to-text

# -----------------------------------------------------------------------------
# TEXT-TO-SPEECH (Sarvam Bulbul)
# -----------------------------------------------------------------------------
TTS_PROVIDER=sarvam             # sarvam | mock
# Change this to any Bulbul voice id from your Sarvam console (e.g. shubh, meera, ...).
SARVAM_TTS_VOICE=shubh
# Sarvam Bulbul cost (configurable for cost tracking)
TTS_COST_PER_CHAR=0.003
# Sarvam Bulbul TTS request tuning
TTS_MODEL=bulbul:v3             # bulbul:v3 (latest) | bulbul:v2
TTS_LANGUAGE_CODE=hi-IN         # BCP-47 code of the agent's voice language
TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
TTS_PACE=1.0                    # speech speed (bulbul:v3 range 0.5-2.0)
TTS_OUTPUT_CODEC=wav            # wav | mp3 | linear16 | mulaw | alaw | opus | flac | aac
TTS_SAMPLE_RATE=24000           # 8000 | 16000 | 22050 | 24000 ... (24kHz default for v3)

# -----------------------------------------------------------------------------
# LLM - OPTIONAL / FUTURE. Default `fixed` = rule-only engine, no external LLM.
# -----------------------------------------------------------------------------
# `fixed` = deterministic Hinglish rule engine, ZERO LLM calls, zero LLM cost.
# `mock`  = deterministic stand-in (tests/development).
# `gemini`= real Gemini (FUTURE) - requires GEMINI_API_KEY.
LLM_PROVIDER=fixed              # fixed | mock | gemini
# To enable Gemini later, set LLM_PROVIDER=gemini AND fill GEMINI_API_KEY, then
# restart. Kept OUT of the default so nothing is ever charged.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini REST base URL
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Gemini 2.5 Flash-Lite cost (verified ~$0.10/M input, $0.40/M output)
LLM_COST_PER_1M_INPUT=0.10
LLM_COST_PER_1M_OUTPUT=0.40

# -----------------------------------------------------------------------------
# CONVERSATION / CALLS
# -----------------------------------------------------------------------------
MOCK_MODE=true                  # true = no real paid calls; mocks all providers
RECORDING_ENABLED=false         # request call recording from the telephony provider
TRANSCRIPT_STORAGE_ENABLED=true

# -----------------------------------------------------------------------------
# LIVE TESTING & COST CONTROL (Phase A) - defaults are SAFE
# -----------------------------------------------------------------------------
# Master switch for real (paid) outbound Plivo calls. MUST be true AND
# MOCK_MODE=false before any real call can be placed. Always test one explicit,
# operator-specified number at a time - no bulk/auto campaigns.
LIVE_CALLS_ENABLED=false
# When true, a NO_ANSWER/BUSY call auto-schedules a retry follow-up. Kept off to
# avoid accidental call loops.
AUTO_RETRY_ENABLED=false
# Opt-in for tests that hit real providers (`pytest -m live`). Normal `pytest`
# stays cost-free (MOCK_MODE).
RUN_LIVE_TESTS=false

# -----------------------------------------------------------------------------
# SECURITY - production MUST override the dev defaults
# -----------------------------------------------------------------------------
# Admin API key required on every management route (X-API-Key header).
# Swagger: click Authorize and enter this value. Dashboard: Settings -> Admin API Authentication.
ADMIN_API_KEY=dev-admin-key
# Shared secret verifying telephony webhooks + media WebSocket (X-Webhook-Token).
# Leave empty to run webhooks unauthenticated during local development.
WEBHOOK_TOKEN=
# Maximum accepted request body size in bytes (request hardening).
MAX_REQUEST_BYTES=1000000
